{
  "name": "E2E-RAG-System",
  "image": "ghcr.io/athithya-sakthivel/rag8s-devcontainer@sha256:b094f7ef0b1548a0a9f7b4f722afcc6c117b11e3a6fe22cc8ab9329e1608f6a4",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "remoteUser": "root",
  "forwardPorts": [
    3000,
    3001,
    8000,
    8001,
    8080,
    50051,
    8005,
    7000,
    7001,
    7002,
    7003,
    6379,
    2000,
    9153,
    9090,
    30080,
    443,
    80
  ],
  "runArgs": [
    "--privileged",
    "--network=host",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined",
    "-v",
    "/var/run/docker.sock:/var/run/docker.sock",
    "--shm-size=11g"
  ],
  "containerEnv": {
    "DOCKER_GID": "999",
    "DOCKER_PROXY_HOST": "",
    "DOCKER_PROXY_PORT": ""
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers"
      ],
      "settings": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "terminal.integrated.scrollback": 2500,
        "workbench.colorTheme": "Default Dark Modern",
        "workbench.preferredDarkColorTheme": "Default Dark Modern"
      }
    }
  }
}